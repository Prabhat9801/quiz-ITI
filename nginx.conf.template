server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback - client-side routes (react-router) all resolve to index.html.
    # index.html must never be cached, otherwise browsers keep referencing old,
    # content-hashed JS/CSS bundle filenames after a new deploy.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # sql.js wasm file must be served with the correct MIME type
    location ~* \.wasm$ {
        add_header Content-Type application/wasm;
    }

    # Question bank JSON changes across deploys now (question bank is being actively
    # expanded unit-by-unit, unlike the original one-time-build assumption). Do NOT
    # cache this immutably any more - a returning visitor's browser would otherwise
    # keep serving a stale question bank for up to a year after a new deploy. Cache
    # briefly with must-revalidate so repeat requests within a session are still fast,
    # but any new deploy is picked up on the visitor's very next page load.
    location /questions/ {
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
}
